# Cloudflare Pages — cabeçalhos

# Assets versionados por nome: cache longo.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# HTML sempre revalidado, para que uma correção de copy suba na hora.
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# Enquanto está em *.pages.dev, reforça o robots.txt —
# o header é respeitado mesmo quando o crawler chega por link direto.
/*
  X-Robots-Tag: noindex
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
